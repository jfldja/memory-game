{
  "name": "memory-game",
  "version": "1.0.0",
  "private": true,
  "description": "翻牌記憶遊戲（純靜態網頁）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs dist",
    "serve:src": "node scripts/serve.mjs src",
    "test:unit": "node --test 'tests/unit/**/*.test.mjs' 'tests/acceptance/unit/**/*.test.mjs'",
    "check:ids": "node scripts/check-acceptance-ids.mjs",
    "test:e2e": "node scripts/build.mjs && playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:realtime": "node scripts/build.mjs && playwright test --project=chromium-realtime --project=firefox-realtime --project=webkit-realtime --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
